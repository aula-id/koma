{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koma.run/schemas/sec-catalog-row.json",
  "title": "Koma security tool catalog",
  "type": "object",
  "required": ["version", "pack", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "pack": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "id", "name", "summary", "categories", "effect", "exec",
        "lanes", "plan_ok", "ready", "scope_needed", "image_or_pack"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "effect": { "type": "string", "enum": ["static", "local", "remote", "exploit"] },
        "exec": { "type": "string", "enum": ["cpu", "binary", "net", "browser"] },
        "lanes": {
          "type": "array",
          "items": { "type": "string", "enum": ["research", "red", "blue"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "plan_ok": { "type": "boolean", "description": "Concrete tools are almost always false; only meta catalog is plan-safe." },
        "ready": { "type": "boolean" },
        "requires": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "scope_needed": { "type": "boolean" },
        "image_or_pack": { "type": "string", "minLength": 1 },
        "how_to": { "type": "string" }
      }
    }
  }
}
