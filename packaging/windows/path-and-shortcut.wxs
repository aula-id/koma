<?xml version="1.0" encoding="utf-8"?>
<!--
  cargo-packager WiX fragment for koma.

  Wired in via [package.metadata.packager.wix] in src-agent/Cargo.toml:
    fragment-paths       = ["../packaging/windows/path-and-shortcut.wxs"]
    component-group-refs = ["KomaPathAndShortcut"]

  koma vendors the full WiX main template (packaging/windows/main.wxs, wired via
  the wix.template config key). That vendored template adds Arguments="gui" to
  the *default* Desktop + Start Menu shortcuts, so they launch `koma gui` (the
  desktop GUI) instead of bare koma.exe (the ratatui TUI) — the shortcut side is
  handled there, not in this fragment. This fragment now fills only the one
  remaining gap the built-in template leaves:

    - KomaPathEnvComponent: adds [INSTALLDIR] to the current *user's* PATH
      (HKCU-scoped, System="no") so `koma` is runnable from any shell after
      install, without requiring elevation for the env var propagation.

  (An extra "koma GUI" Start Menu shortcut used to live here; it was removed once
  the vendored main.wxs made the default shortcuts launch the GUI directly — a
  separate entry would just duplicate them.)

  cargo-packager's built-in template declares a "PATH Environment Variable"
  *Feature* (Id "Environment"), but that feature only gates whether the exe file
  itself gets installed - it never actually writes an Environment table entry, so
  INSTALLDIR is never added to PATH. That is exactly what KomaPathEnvComponent
  fixes.

  The DirectoryRef target INSTALLDIR is declared by the (koma-vendored) main.wxs;
  DirectoryRef references across separate candle.exe compilation units resolve at
  light.exe link time, so no re-declaration is needed here.

  `$(var.Win64)` is intentionally NOT used here: it is a `<?define?>`
  preprocessor symbol local to main.wxs's own candle.exe pass (each .wxs
  fragment is compiled as its own separate candle.exe invocation with only
  `-dSourceDir` passed on the command line), so it is undefined when this
  file is compiled on its own.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <!-- User-scope PATH entry: avoids requiring elevation for env propagation. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="KomaPathEnvComponent" Guid="3B8ABF3F-F2CD-4F42-B266-8288F394A14A">
        <RegistryValue Root="HKCU" Key="Software\koma" Name="PathAdded" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="KomaPath" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="no" />
      </Component>
    </DirectoryRef>

    <!-- Must keep the Id "KomaPathAndShortcut" (referenced by Cargo.toml's
         component-group-refs); it holds a single component now that the GUI
         shortcut lives in the vendored main.wxs. -->
    <ComponentGroup Id="KomaPathAndShortcut">
      <ComponentRef Id="KomaPathEnvComponent" />
    </ComponentGroup>

  </Fragment>
</Wix>
